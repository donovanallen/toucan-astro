---
import Layout from '../layouts/Layout.astro';
import PortfolioData from '../data/portfolio.js';

const items = PortfolioData.items;
---

<Layout title="Portfolio | Donovan Allen" active="portfolio">
  <div class="container">
    {items.map((item, index) => (
      <>
        <div class="portfolio-item" style={`animation-delay: ${index * 60}ms`}>
          <a href={item.link} aria-label={`${item.title} — ${item.subtitle}`}>
            <img
              src={item.images[0].src}
              alt={item.images[0].alt}
              class="portfolio-item-img"
              loading={index === 0 ? 'eager' : 'lazy'}
            />
          </a>
          <div class="portfolio-item-text">
            <div>
              <h4 class="portfolio-item-text-title">{item.title}</h4>
              <span>{item.subtitle}</span>
            </div>
            <h5 class="portfolio-item-desc">{item.overview}</h5>
          </div>
        </div>
        {index !== items.length - 1 && <hr />}
      </>
    ))}
  </div>
</Layout>

<style lang="scss" global>
  @use "../styles/vars" as *;
  .container {
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    padding: var(--space-xs) 0;

    hr {
      width: 90%;
    }

    .portfolio-item {
      margin: 0 auto;
      width: 70%;

      // Staggered group entrance (occasional page, 60ms steps)
      animation: page-reveal var(--dur-slow) var(--ease-out) both;

      &-img {
        width: 100%;
        border-radius: 12px;
        opacity: 0.7;
        scale: 1;
        filter: grayscale(1);
        margin: var(--space-s) 0;
        transition:
          opacity var(--dur-base) var(--ease-out),
          scale var(--dur-base) var(--ease-out),
          filter var(--dur-base) var(--ease-out),
          box-shadow var(--dur-base) var(--ease-out);

        // Hover transforms only where hover exists — no sticky hover on touch
        @media (hover: hover) and (pointer: fine) {
          &:hover {
            opacity: 1;
            scale: 1.05;
            box-shadow: rgba(0, 0, 0, 0.3) 0px 19px 38px,
              rgba(0, 0, 0, 0.22) 0px 15px 12px;
            filter: grayscale(0);
            border: 0.75px solid $scilentBlack;
          }
        }
      }

      &-text {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        width: 100%;
        &-title {
          margin-bottom: var(--space-xs);
        }
        .portfolio-item-desc {
          max-width: 50%;
          margin-bottom: var(--space-xs);
          text-align: right;
          line-height: 1;
          color: $dark;
          opacity: 0.7;
        }
      }
    }
  }
</style>
