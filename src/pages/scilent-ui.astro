---
import Layout from '../layouts/Layout.astro';

const kitImages = [
  { src: '/images/scilent-ui/kit-cover.png', alt: 'scilent ui style guide cover' },
  { src: '/images/scilent-ui/kit-typography.png', alt: 'scilent ui typography' },
  { src: '/images/scilent-ui/kit-color.png', alt: 'scilent ui colors' },
];
---

<Layout title="Scilent UI | Donovan Allen">
  <div class="scilent-ui-page">
    <h1 class="centered">scilent ui</h1>
    <h3 class="centered">
      A component and utility library for digital music interfaces
    </h3>
    <img class="hero-img" src="/images/scilent-ui/cover.png" alt="scilent ui hero" />
    <hr />

    <a
      class="centered-link"
      href="https://github.com/donovanallen/scilent-ui/blob/main/DESIGN.md"
      target="_blank"
      rel="noopener noreferrer"
    >
      design guidelines
    </a>
    <hr />
    <h2 class="centered">style guide</h2>
    <div class="features">
      {kitImages.map((img) => (
        <div class="feature media-item">
          <img src={img.src} alt={img.alt} data-fullscreen />
        </div>
      ))}
    </div>

    <hr />

    <div class="links-row">
      <a
        href="https://www.figma.com/design/Bqh3px6uH4VKDGkdypcFPu/Scilent-UI---Music-UI-Kit?m=auto&t=j1dMJQCfbQbhBJUf-1"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Figma"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 5.5A3.5 3.5 0 0 1 8.5 2H12v7H8.5A3.5 3.5 0 0 1 5 5.5z"></path><path d="M12 2h3.5a3.5 3.5 0 1 1 0 7H12V2z"></path><path d="M12 12.5a3.5 3.5 0 1 1 7 0 3.5 3.5 0 1 1-7 0z"></path><path d="M5 19.5A3.5 3.5 0 0 1 8.5 16H12v3.5a3.5 3.5 0 1 1-7 0z"></path><path d="M5 12.5A3.5 3.5 0 0 1 8.5 9H12v7H8.5A3.5 3.5 0 0 1 5 12.5z"></path></svg>
      </a>
      <a href="https://github.com/donovanallen/scilent-ui" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
      </a>
    </div>
  </div>
</Layout>

<script>
  // Fullscreen overlay on image click (stand-in for the React state toggle)
  function setup() {
    if (document.querySelector('.fullscreen-overlay')) return;
    const overlay = document.createElement('div');
    overlay.className = 'fullscreen-overlay';
    overlay.style.display = 'none';
    const img = document.createElement('img');
    overlay.appendChild(img);
    overlay.addEventListener('click', () => {
      overlay.style.display = 'none';
    });
    document.body.appendChild(overlay);
    document.querySelectorAll('img[data-fullscreen]').forEach((el) => {
      el.addEventListener('click', () => {
        img.src = el.getAttribute('src');
        overlay.style.display = 'flex';
      });
    });
  }
  document.addEventListener('DOMContentLoaded', setup);
  setup();
</script>

<style lang="scss" global>
  @use "../styles/vars" as *;
  .scilent-ui-page {
    display: flex;
    flex: 1;
    flex-direction: column;
    width: 100%;
    overflow-y: auto;
    align-items: center;
    padding-bottom: var(--space-m);

    .centered {
      text-align: center;
    }
    .centered-link {
      margin: var(--space-m) 0;
    }
    .hero-img {
      width: 90vw;
      margin: var(--space-m) 0;
    }

    .features {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-m);
      justify-content: center;
      width: 90vw;

      .media-item img {
        width: 100%;
        max-width: 480px;
        border-radius: 12px;
        cursor: zoom-in;
      }
    }

    .links-row {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: var(--space-m);
      width: 100%;
      justify-content: center;
      margin-top: var(--space-m);

      a {
        opacity: 0.3;
        transition: opacity 0.3s ease;
        &:hover {
          opacity: 1;
        }
      }
    }
  }

  .fullscreen-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    cursor: zoom-out;

    img {
      max-width: 95vw;
      max-height: 95vh;
    }
  }
</style>
