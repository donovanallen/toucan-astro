---
import Layout from '../layouts/Layout.astro';
import SiteData from '../data/site.json';

const socials = SiteData.socials;
const siteEmail = SiteData.site.email;
---

<Layout title="Contact | Donovan Allen" active="contact">
  <div class="contact-content">
    <div>
      <h2 class="contact-heading-text">let's connect!</h2>
    </div>
    <div class="contact-links">
      <div class="icon-grid">
        {socials.map((social) => (
          <div class="icon-grid-link">
            <a
              href={social.href}
              target={social.external ? '_blank' : undefined}
              rel={social.external ? 'noopener noreferrer' : undefined}
              aria-label={social.label}
            >
              <img class="icon float-shadow" src={`/icons/${social.icon}.svg`} alt="" />
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style lang="scss" global>
  @use "../styles/vars" as *;
  .contact-content {
    display: flex;
    flex: 1;
    justify-content: space-around;
    align-items: center;
    padding: 0 var(--space-m);
  }

  .contact-heading-text {
    margin: 0;
    flex: 1;
  }

  .contact-links {
    display: flex;
    align-items: center;

    .icon-grid {
      display: flex;
      gap: var(--space-l);
      @media only screen and (max-width: 1200px) {
        flex-direction: column;
      }

      .icon-grid-link,
      .icon {
        max-height: 50px;
        width: 50px;
        @media only screen and (max-width: 990px) {
          max-height: 35px;
          width: 35px;
        }
      }
      .icon {
        filter: invert(11%) sepia(5%) saturate(6405%) hue-rotate(198deg)
          brightness(90%) contrast(79%);
        opacity: 0.7;
        transition:
          opacity var(--dur-base) var(--ease-out),
          transform var(--dur-base) var(--ease-out);

        // Hover transforms only where hover exists — no sticky hover on touch
        @media (hover: hover) and (pointer: fine) {
          &:hover {
            opacity: 1;
            transform: scale(1.2);
          }
        }
      }

      // Press feedback, any pointer type
      .icon-grid-link:active .icon {
        opacity: 1;
        transform: scale(0.95);
        transition-duration: var(--dur-fast);
      }
    }
  }
</style>
